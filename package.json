{
  "name": "sme-cashflow-invoice-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend-first SME cash flow and invoice management system",
  "license": "UNLICENSED",
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "babel src --out-dir dist --extensions .js --copy-files",
    "format": "prettier --write \"src/**/*.js\" \"test/**/*.js\" \"scripts/**/*.js\" \"*.{json,js,cjs,mjs,md}\"",
    "format:check": "prettier --check \"src/**/*.js\" \"test/**/*.js\" \"scripts/**/*.js\" \"*.{json,js,cjs,mjs,md}\"",
    "start": "npm run build && node dist/main.js",
    "start:dev": "nodemon --watch src --ext js --exec \"npm run start\"",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,test,scripts}/**/*.js\" \"*.{js,cjs,mjs}\"",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.cjs --runInBand",
    "test:unit": "npm run test",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.cjs --watch",
    "test:e2e": "node --env-file-if-exists=.env --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.e2e.config.cjs --runInBand",
    "test:integration": "node --env-file=.env test/integration/run-integration-tests.js",
    "test:queues": "node --env-file-if-exists=.env --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.queues.config.cjs --runInBand --detectOpenHandles",
    "infra:up": "docker compose up -d postgres redis",
    "infra:down": "docker compose down",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@nestjs/common": "^12.1.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.0",
    "@nestjs/platform-express": "^12.1.0",
    "@prisma/client": "^6.19.0",
    "argon2": "^0.45.1",
    "bullmq": "^6.3.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "nestjs-pino": "^5.2.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.3",
    "@babel/core": "^7.28.4",
    "@babel/eslint-parser": "^7.28.5",
    "@babel/plugin-proposal-decorators": "^7.28.0",
    "@babel/plugin-transform-class-properties": "^7.27.1",
    "@eslint/js": "^9.39.1",
    "@nestjs/testing": "^12.1.0",
    "babel-jest": "^29.7.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.9.9",
    "prisma": "^6.19.0",
    "supertest": "^7.3.0"
  }
}
