# Active foundation configuration
NODE_ENV=development
PORT=3000
API_PREFIX=api
API_VERSION=1
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info
TRUST_PROXY=false

# Local PostgreSQL configuration. Replace change_me in your ignored .env file.
POSTGRES_DB=sme_cashflow
POSTGRES_USER=sme_app
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

DATABASE_URL=postgresql://sme_app:change_me@localhost:5432/sme_cashflow
DATABASE_URL_TEST=postgresql://sme_app:change_me@localhost:5432/sme_cashflow_test

# Local Redis/BullMQ configuration. Authentication is optional for local development.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
QUEUE_PREFIX=sme

# Known local-only Ed25519 keys. Generate and securely manage unique keys outside development.
AUTH_ACCESS_PRIVATE_KEY_BASE64=MC4CAQAwBQYDK2VwBCIEIDdyP69H0Zo0OMz9ELCqVFpF9wwAIH2Fm6GGNtW6YRX8
AUTH_ACCESS_PUBLIC_KEY_BASE64=MCowBQYDK2VwAyEABdqDMyeA8N8yOW/It/UtBCMURg8cJkEWDd0PiBwYeUw=
AUTH_ACCESS_TOKEN_LIFETIME_SECONDS=900
AUTH_REFRESH_TOKEN_LIFETIME_DAYS=30
AUTH_JWT_ISSUER=sme-cashflow-api
AUTH_JWT_AUDIENCE=sme-cashflow-client
AUTH_JWT_KEY_ID=local-development-1
AUTH_COOKIE_NAME=sme_refresh
AUTH_RATE_LIMIT_PREFIX=sme:auth-rate
AUTH_REGISTER_RATE_LIMIT_PER_HOUR=5
AUTH_LOGIN_RATE_LIMIT_PER_MINUTE=5
AUTH_LOGIN_RATE_LIMIT_PER_HOUR=20
AUTH_REFRESH_RATE_LIMIT_PER_MINUTE=30
